# Copy to .env and fill in. Used for local testing only.

# --- LLM ---
LLM_PROVIDER=openai            # openai | gemini | custom
LLM_API_KEY=
LLM_MODEL=                     # optional; provider default used if blank
LLM_BASE_URL=                  # only needed when LLM_PROVIDER=custom
LLM_REASONING_EFFORT=          # optional: minimal | low | medium | high (default: low for gemini)
LLM_TIMEOUT=180                # HTTP read timeout in seconds
LLM_FALLBACK_MODELS=           # optional comma-separated fallback models (default: gemini-3.5-flash-lite for gemini)

# --- Digest & Enrichment (hn_digest.py) ---
TOP_N=15
FETCH_MODE=24h                 # 24h | front_page
DEDUP_ENABLED=true             # skip stories seen in the last 7 days
STATE_FILE=state/seen.json     # path for rolling seen-story state
FETCH_ARTICLES=true            # fetch article excerpts for grounded 1-line TL;DRs
COMMENT_TOP_K=8                # fetch top HN comments for top K stories (+ spiciest debate)
ASK_SHOW_N=3                   # extra Ask HN / Show HN threads mined for pain points
ARCHIVE_DIR=                   # optional dir (e.g. .data) to persist daily/weekly JSON archives

# --- Weekly Synthesis (weekly_synthesis.py) ---
WATCHLIST_FILE=watchlist.json  # bellwether repos monitored for high-reaction open issues
WEEKLY_REASONING_EFFORT=medium # reasoning depth for weekly synthesis
WEEKLY_LLM_TIMEOUT=240
NOTION_API_KEY=                # optional: push weekly brief to Notion
NOTION_DATABASE_ID=            # optional: target Notion database ID

# --- GitHub Trending (gh_trending.py) ---
GH_TOP_N=10
GH_LANGUAGE=                   # optional language slug (e.g. python, rust); blank = all
GH_SINCE=daily                 # daily | weekly | monthly
GH_DEDUP_ENABLED=true          # skip repos seen in the last 7 days
GH_STATE_FILE=state/gh_seen.json
GH_FETCH_READMES=true          # fetch README excerpts for grounded summaries

# --- Email (SMTP). Leave blank to print to stdout instead. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_STARTTLS=true
EMAIL_FROM=
EMAIL_TO=
